# Copy to .env (git-ignored) for local development.

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Option B: a local model through Ollama's OpenAI-compatible API (run `ollama serve` first)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434
# OPENAI_MODEL=qwen2.5:7b

# App Check is off locally so you can call the API with curl.
APP_CHECK_ENABLED=false
FIREBASE_PROJECT_NUMBER=
