root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = intellij_idea
# Test names in backticks read like sentences in test reports.
ktlint_function_naming_ignore_when_annotated_with = Test

[*.{yml,yaml,json,toml}]
indent_size = 2
